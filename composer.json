{
    "name": "sobhanmohammadi/cas",
    "description": "A modern, exact-arithmetic Computer Algebra System for PHP 8.2+, with step-by-step explanations and zero runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {"name": "sobhanmohammadi-dev", "email": "sobhanmohammadi.dev@gmail.com"}
    ],
    "require": {
        "php": "^8.2",
        "ext-gmp": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Sobhanmohammadi\\CAS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sobhanmohammadi\\CAS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
